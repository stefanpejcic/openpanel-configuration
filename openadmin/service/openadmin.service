[Unit]
Description=OpenAdmin
After=network-online.target
Wants=network-online.target

[Service]
User=root
WorkingDirectory=/usr/local/admin/
ExecStart=/usr/local/admin/venv/bin/gunicorn -c /etc/openpanel/openadmin/service/service.config.py app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
TimeoutStopSec=30
KillMode=mixed
# keep the control plane responsive and alive when the server is under load
Nice=-5
OOMScoreAdjust=-800
CPUWeight=400
MemoryLow=128M

[Install]
WantedBy=multi-user.target
